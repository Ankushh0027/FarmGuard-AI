# ==============================================================================
# FarmGuard AI Backend - Environment Configuration Template
# ==============================================================================

# Application Environment (development, test, staging, production)
APP_ENV=development

# Debug Mode (MUST be false in production)
DEBUG=false

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list; e.g., https://farmguard.ai,http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# API Security & Authentication
# When enabled, clients must provide X-API-Key or Authorization: Bearer <key>
API_AUTH_ENABLED=false
API_KEYS=fg_dev_key_12345,fg_dev_key_67890

# Rate Limiting (maximum requests per client IP / API key per minute)
RATE_LIMIT_PER_MINUTE=60

# Max Request Body Size (in bytes; default 1048576 = 1MB)
MAX_CONTENT_LENGTH=1048576

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# External Services
# Gemini API Key (Required for live Gemini LLM synthesis; deterministic fallback activates if omitted)
GEMINI_API_KEY=

# Weather API
WEATHER_API_KEY=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
